# /etc/miri.env (권한 600). 값은 저장소에 두지 않는다
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
MIRI_RUNTIME=ncp-server
MIRI_STATIC_DIR=/opt/miri/client/dist
MIRI_STORE=redis
REDIS_URL=redis://127.0.0.1:6379
MIRI_DEMO_CODE=
MIRI_SESSION_SECRET=
NCP_OCR_INVOKE_URL=
NCP_OCR_SECRET=
NCP_CLOVASTUDIO_KEY=
NCP_CSR_CLIENT_ID=
NCP_CSR_CLIENT_SECRET=
DATA_GO_KR_KEY=
