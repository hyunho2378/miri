[Unit]
Description=Miri API and web (Naver Cloud)
After=network-online.target redis-server.service
Wants=redis-server.service

[Service]
EnvironmentFile=/etc/miri.env
WorkingDirectory=/opt/miri
ExecStart=/usr/bin/node /opt/miri/server/index.mjs
Restart=always
RestartSec=2
User=root
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
